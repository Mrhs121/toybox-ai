<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_dock"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:background="@drawable/bg_dock"
    android:elevation="16dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/dock_connections"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dock_connections_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/nav_connections"
            android:src="@drawable/ic_server"
            android:tint="@color/text_muted_on_dark" />

        <TextView
            android:id="@+id/dock_connections_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_connections"
            android:textColor="@color/text_muted_on_dark"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_terminal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dock_terminal_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/nav_terminal"
            android:src="@drawable/ic_terminal"
            android:tint="@color/text_muted_on_dark" />

        <TextView
            android:id="@+id/dock_terminal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_terminal"
            android:textColor="@color/text_muted_on_dark"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dock_settings_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_muted_on_dark" />

        <TextView
            android:id="@+id/dock_settings_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_settings"
            android:textColor="@color/text_muted_on_dark"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
