<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_tab_card"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_terminal_tab"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp">

    <!-- Active Indicator Dot -->
    <View
        android:id="@+id/terminal_tab_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:background="@drawable/bg_status_dot_glow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/terminal_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxWidth="220dp"
        android:maxLines="1"
        android:textColor="@color/terminal_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/close_tab_button"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_tab_description"
        android:padding="4dp"
        android:src="@drawable/ic_tab_close"
        android:tint="@color/text_muted_on_dark" />
</LinearLayout>
